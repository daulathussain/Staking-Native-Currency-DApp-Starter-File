# ===================================
# BLOCKCHAIN NETWORK CONFIGURATION
# ===================================

# Network RPC URLs
POLYGON_RPC_URL=https://rpc.ankr.com/polygon/

# Default Network (polygon)
NEXT_PUBLIC_NETWORK=polygon

# Chain IDs
NEXT_PUBLIC_POLYGON_CHAIN_ID=137

# ===================================
# DEPLOYMENT CONFIGURATION
# ===================================

# Private key for contract deployment (DO NOT COMMIT THIS!)
PRIVATE_KEY=

# ===================================
# REWARD TOKEN CONFIGURATION
# ===================================

# Your existing ERC20 reward token address on Polygon
REWARD_TOKEN_ADDRESS=
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=

# ===================================
# STAKING CONTRACT CONFIGURATION
# ===================================

# APR: 12% (hardcoded in contract)
# Early Withdrawal Penalty: 5% (hardcoded in contract)
# Pools: 30, 90, 180, 360 days (hardcoded in contract)

# Minimum stake amount in native currency (in wei)
# Example: 10000000000000000 = 0.01 POL
MINIMUM_STAKE=10000000000000000

# ===================================
# CONTRACT ADDRESSES (After Deployment)
# ===================================

# Staking contract address (will be filled after deployment)
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=

# ===================================
# FRONTEND CONFIGURATION
# ===================================

# Application Name
NEXT_PUBLIC_APP_NAME=Native Currency Staking DApp

# WalletConnect Project ID (Get from https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=


